# DigitallyDefined Website Environment Variables
# Copy this file to .env.local and fill in values

# Supabase
VITE_SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API
VITE_DASHBOARD_API_KEY=DigitallyDefined-OS-2026
VITE_DASHBOARD_API_URL=https://dijjlppdljpcgyoakdnq.supabase.co/functions/v1

# Hermes AI Mentor
VITE_HERMES_ENDPOINT=https://dijjlppdljpcgyoakdnq.supabase.co/functions/v1/hermes
# Action sent to the Hermes edge function. 'public.chat' needs no API key.
VITE_HERMES_ACTION=public.chat

# AI Providers
OPENROUTER_API_KEY=YOUR_KEY_HERE
AGNES_API_KEY=YOUR_AGNES_API_KEY_HERE

# Google Sheets (for vault sync)
VITE_SHEETS_API_URL=https://script.google.com/macros/s/AKfycbwEyg9UPQrxOgNVhkzGWRZAULMkjE4rCQhAKuYUoAoPEG1bCr0xU74X8dRRuyV53ARk/exec

# Brevo Email (optional - leave empty for dev mode)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_LIST_ID=your-brevo-list-id
BREVO_FROM_EMAIL=hello@digitallydefined.online
BREVO_FROM_NAME=DigitallyDefined
